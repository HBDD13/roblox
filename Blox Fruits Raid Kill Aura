local chatConnection = plr.Chatted:Connect(function(message)
	if message == "/e stop" then
		Stop()
	end
end)
TurnOff.MouseButton1Click:Connect(function ()
	HoverSound:Play()
	Stop()
end)

TurnOff.MouseEnter:Connect(function ()
	HoverSound:Play()
	HoverTween:Play()
end)
TurnOff.MouseLeave:Connect(function ()
	ResetTween:Play()
end)
TurnOff.MouseButton1Down:Connect(function ()
	DownTween:Play()
end)

function Stop()
	chatConnection:Disconnect()
	Coolkidds1:Destroy()
	stopped = true
	debris:AddItem(ClickSound, 1)
	debris:AddItem(HoverSound, 1)
end
