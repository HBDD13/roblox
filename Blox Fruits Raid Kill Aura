local players = game:GetService("Players")
local ts = game:GetService("TweenService")
local debris = game:GetService("Debris")

local plr = players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()

local killRange = 500
local stopped = false

task.spawn(function ()
	while task.wait(0.5) and not stopped do
		char = plr.Character or plr.CharacterAdded:Wait()

		local rootPart = char:FindFirstChild("HumanoidRootPart")

		if not rootPart then
			continue
		end

		local hits = workspace:GetPartBoundsInRadius(rootPart.Position, killRange)

		for _, h in hits do
			if not h.Parent then
				continue
			end

			local hitCharacter = h:FindFirstAncestorOfClass("Model")

			if not hitCharacter then
				continue
			end

			if players:GetPlayerFromCharacter(hitCharacter) then
				continue
			end

			local hum = hitCharacter:FindFirstChildOfClass("Humanoid")

			if not hum then
				continue
			end

			hum.Health = 0
			hitCharacter:BreakJoints()
		end
	end
end)

