--// AuraESP

local AuraESP = {}

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GUI = Instance.new("ScreenGui")
GUI.Name = "AuraESP"
GUI.IgnoreGuiInset = true
GUI.ResetOnSpawn = false
GUI.DisplayOrder = 998
GUI.Parent = game:GetService("CoreGui")

local Markers = {}
local Connection

local DEFAULTS = {
	Color = nil,
	DotColor = Color3.fromRGB(190, 155, 255),
	TextColor = Color3.fromRGB(245, 242, 255),
	OutlineColor = Color3.fromRGB(20, 17, 30),

	DotSize = 8,
	TextSize = 12,
	Font = Enum.Font.GothamSemibold,

	ShowDistance = false,
	DistanceColor = Color3.fromRGB(190, 155, 255),
	DistanceTextSize = 11,
	DistancePrefix = "",
	DistanceSuffix = " studs",

	StrokeColor = Color3.fromRGB(245, 242, 255),
	StrokeThickness = 1,
	StrokeTransparency = 0.2,

	TextStrokeTransparency = 0.15,
	DistanceStrokeTransparency = 0.2,

	Animation = true,
	OffsetY = 0,

	Viewport = false,
	ViewportSize = 64,
}

local function getPosition(target)
	if target:IsA("BasePart") then
		return target.Position
	elseif target:IsA("Model") then
		local root = target.PrimaryPart
			or target:FindFirstChild("HumanoidRootPart")
			or target:FindFirstChildWhichIsA("BasePart", true)

		return root and root.Position
	end
end

local function getBounds(target)
	if target:IsA("BasePart") then
		return target.CFrame, target.Size
	elseif target:IsA("Model") then
		return target:GetBoundingBox()
	end
end

local function createViewport(data)
	local settings = data.Config

	if not settings.Viewport or data.Viewport then
		return
	end

	local target = data.Target

	if not target or not target:IsA("Model") and not target:IsA("BasePart") then
		return
	end

	local success, clone = pcall(function()
		return target:Clone()
	end)

	if not success or not clone then
		return
	end

	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "Viewport"
	viewport.AnchorPoint = Vector2.new(0.5, 0.5)
	viewport.ZIndex = 100
	viewport.Position = UDim2.new(
		0.5, 0, 0,
		settings.ShowDistance and 79 or 63
	)
	viewport.Size = UDim2.fromOffset(
		settings.ViewportSize,
		settings.ViewportSize
	)
	viewport.BackgroundTransparency = 1
	viewport.BorderSizePixel = 0
	viewport.Ambient = Color3.fromRGB(200, 200, 200)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-1, -1, -1)
	viewport.Parent = data.Frame

	local world = Instance.new("WorldModel")
	world.Name = "World"
	world.Parent = viewport

	clone.Parent = world

	local camera = Instance.new("Camera")
	camera.Name = "ViewportCamera"
	camera.FieldOfView = 50
	camera.Parent = viewport

	viewport.CurrentCamera = camera

	local successBounds, boundsCFrame, boundsSize = pcall(function()
		return getBounds(clone)
	end)

	if successBounds and boundsCFrame and boundsSize then
		local maxSize = math.max(
			boundsSize.X,
			boundsSize.Y,
			boundsSize.Z,
			1
		)

		local distance = (maxSize * 0.5) / math.tan(math.rad(camera.FieldOfView * 0.5)) * 1.2
		local center = boundsCFrame.Position
		local direction = boundsCFrame.LookVector

		camera.CFrame = CFrame.lookAt(
			center + direction * distance,
			center
		)
	end

	data.Viewport = viewport
	data.ViewportClone = clone
end

local function removeViewport(data)
	if data.Viewport then
		data.Viewport:Destroy()
		data.Viewport = nil
		data.ViewportClone = nil
	end
end

local function updateLayout(data)
	local settings = data.Config
	local viewportEnabled = settings.Viewport and data.Viewport ~= nil

	data.Frame.Size = UDim2.fromOffset(
		180,
		viewportEnabled and (settings.ShowDistance and 140 or 124)
			or (settings.ShowDistance and 56 or 42)
	)

	data.Name.Position = UDim2.new(
		0.5, 0, 0,
		settings.ShowDistance and 27 or 10
	)

	if data.Distance then
		data.Distance.Position = UDim2.new(0.5, 0, 0, 10)
		data.Distance.Visible = settings.ShowDistance
	end

	local dot = data.Frame:FindFirstChild("Dot")

	if dot then
		dot.Visible = not viewportEnabled
		dot.Position = UDim2.new(
			0.5, 0, 0,
			settings.ShowDistance and 45 or 28
		)
	end

	if data.Viewport then
		data.Viewport.Position = UDim2.new(
			0.5, 0, 0,
			settings.ShowDistance and 79 or 63
		)

		data.Viewport.Size = UDim2.fromOffset(
			settings.ViewportSize,
			settings.ViewportSize
		)
	end
end

function AuraESP.Create(target, name, config)
	if not target then
		return
	end

	if Markers[target] then
		return Markers[target]
	end

	config = config or {}

	local settings = table.clone(DEFAULTS)

	for property, value in config do
		settings[property] = value
	end

	local frame = Instance.new("Frame")
	frame.Name = "ESP"
	frame.Size = UDim2.fromOffset(180, settings.ShowDistance and 56 or 42)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = GUI

	local distanceLabel

	if settings.ShowDistance then
		distanceLabel = Instance.new("TextLabel")
		distanceLabel.Name = "Distance"
		distanceLabel.AnchorPoint = Vector2.new(0.5, 1)
		distanceLabel.Position = UDim2.new(0.5, 0, 0, 10)
		distanceLabel.Size = UDim2.new(1, 0, 0, 16)
		distanceLabel.BackgroundTransparency = 1
		distanceLabel.Font = settings.Font
		distanceLabel.TextColor3 = settings.Color or settings.DistanceColor
		distanceLabel.TextSize = settings.DistanceTextSize
		distanceLabel.TextStrokeColor3 = settings.OutlineColor
		distanceLabel.TextStrokeTransparency = settings.DistanceStrokeTransparency
		distanceLabel.TextTruncate = Enum.TextTruncate.AtEnd
		distanceLabel.Parent = frame
	end

	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 0, settings.ShowDistance and 27 or 10)
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.Font = settings.Font
	label.Text = name or target.Name
	label.TextColor3 = settings.TextColor
	label.TextSize = settings.TextSize
	label.TextStrokeColor3 = settings.OutlineColor
	label.TextStrokeTransparency = settings.TextStrokeTransparency
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = frame

	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.new(0.5, 0, 0, settings.ShowDistance and 45 or 28)
	dot.Size = UDim2.fromOffset(settings.DotSize, settings.DotSize)
	dot.BackgroundColor3 = settings.Color or settings.DotColor
	dot.BorderSizePixel = 0
	dot.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot

	local stroke = Instance.new("UIStroke")
	stroke.Color = settings.StrokeColor
	stroke.Thickness = settings.StrokeThickness
	stroke.Transparency = settings.StrokeTransparency
	stroke.Parent = dot

	local scale = Instance.new("UIScale")
	scale.Scale = settings.Animation and 0.75 or 1
	scale.Parent = frame

	if settings.Animation then
		TweenService:Create(
			scale,
			TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{Scale = 1}
		):Play()
	end

	local data = {
		Frame = frame,
		Name = label,
		Distance = distanceLabel,
		Target = target,
		Config = settings,
		Viewport = nil,
		ViewportClone = nil,
	}

	Markers[target] = data

	if settings.Viewport then
		createViewport(data)
		updateLayout(data)
	end

	return data
end

function AuraESP.Delete(target)
	local data = Markers[target]

	if not data then
		return
	end

	Markers[target] = nil
	data.Frame:Destroy()
end

function AuraESP.Clear()
	for target in Markers do
		AuraESP.Delete(target)
	end
end

function AuraESP.Update(target, config)
	local data = Markers[target]

	if not data then
		return
	end

	for property, value in config do
		data.Config[property] = value
	end

	local settings = data.Config

	data.Name.TextColor3 = settings.Color or settings.TextColor
	data.Name.TextSize = settings.TextSize
	data.Name.Font = settings.Font
	data.Name.TextStrokeColor3 = settings.OutlineColor
	data.Name.TextStrokeTransparency = settings.TextStrokeTransparency

	local dot = data.Frame:FindFirstChild("Dot")

	if dot then
		dot.BackgroundColor3 = settings.Color or settings.DotColor
		dot.Size = UDim2.fromOffset(settings.DotSize, settings.DotSize)

		local stroke = dot:FindFirstChildOfClass("UIStroke")

		if stroke then
			stroke.Color = settings.StrokeColor
			stroke.Thickness = settings.StrokeThickness
			stroke.Transparency = settings.StrokeTransparency
		end
	end

	if settings.ShowDistance and not data.Distance then
		local distance = Instance.new("TextLabel")
		distance.Name = "Distance"
		distance.AnchorPoint = Vector2.new(0.5, 1)
		distance.Position = UDim2.new(0.5, 0, 0, 10)
		distance.Size = UDim2.new(1, 0, 0, 16)
		distance.BackgroundTransparency = 1
		distance.Parent = data.Frame

		data.Distance = distance
	end

	if data.Distance then
		data.Distance.Visible = settings.ShowDistance
		data.Distance.TextColor3 = settings.Color or settings.DistanceColor
		data.Distance.TextSize = settings.DistanceTextSize
		data.Distance.Font = settings.Font
		data.Distance.TextStrokeColor3 = settings.OutlineColor
		data.Distance.TextStrokeTransparency = settings.DistanceStrokeTransparency
	end

	if settings.Viewport then
		createViewport(data)
	else
		removeViewport(data)
	end

	updateLayout(data)
end

Connection = RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	for target, data in Markers do
		local position = getPosition(target)

		if not position or not target:IsDescendantOf(game) then
			data.Frame.Visible = false
			continue
		end

		local screenPosition, onScreen =
			camera:WorldToViewportPoint(position)

		data.Frame.Visible = onScreen and screenPosition.Z > 0

		if not data.Frame.Visible then
			continue
		end

		data.Frame.Position = UDim2.fromOffset(
			screenPosition.X,
			screenPosition.Y + data.Config.OffsetY
		)

		if data.Distance then
			local distance = (camera.CFrame.Position - position).Magnitude

			data.Distance.Text = data.Config.DistancePrefix
				.. tostring(math.floor(distance + 0.5))
				.. data.Config.DistanceSuffix
		end
	end
end)

function AuraESP.Destroy()
	AuraESP.Clear()

	if Connection then
		Connection:Disconnect()
		Connection = nil
	end

	GUI:Destroy()
end

return AuraESP
