
--// AuraESP

local AuraESP = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer

local GUI = Instance.new("ScreenGui")
GUI.Name = "AuraESP"
GUI.IgnoreGuiInset = true
GUI.ResetOnSpawn = false
GUI.DisplayOrder = 998
GUI.Parent = game:GetService("CoreGui")

local Markers = {}
local Connection

local COLORS = {
	Dot = Color3.fromRGB(190, 155, 255),
	Text = Color3.fromRGB(245, 242, 255),
	Outline = Color3.fromRGB(20, 17, 30),
}

function AuraESP.Create(target, name)
	if not target or Markers[target] then
		return Markers[target]
	end

	local frame = Instance.new("Frame")
	frame.Name = "ESP"
	frame.Size = UDim2.fromOffset(150, 42)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = GUI

	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 0, 10)
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamSemibold
	label.Text = name or target.Name
	label.TextColor3 = COLORS.Text
	label.TextSize = 12
	label.TextStrokeColor3 = COLORS.Outline
	label.TextStrokeTransparency = 0.15
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = frame

	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.new(0.5, 0, 0, 28)
	dot.Size = UDim2.fromOffset(8, 8)
	dot.BackgroundColor3 = COLORS.Dot
	dot.BorderSizePixel = 0
	dot.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot

	local stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.Text
	stroke.Thickness = 1
	stroke.Transparency = 0.2
	stroke.Parent = dot

	local scale = Instance.new("UIScale")
	scale.Scale = 0.75
	scale.Parent = frame

	TweenService:Create(
		scale,
		TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Scale = 1}
	):Play()

	Markers[target] = {
		Frame = frame,
		Name = label,
	}

	return Markers[target]
end

function AuraESP.Delete(target)
	local data = Markers[target]

	if not data then
		return
	end

	Markers[target] = nil
	data.Frame:Destroy()
end

function AuraESP.Clear()
	for target in Markers do
		AuraESP.Delete(target)
	end
end

Connection = RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	for target, data in Markers do
		local position

		if target:IsA("BasePart") then
			position = target.Position
		elseif target:IsA("Model") then
			local root = target.PrimaryPart
				or target:FindFirstChild("HumanoidRootPart")
				or target:FindFirstChildWhichIsA("BasePart", true)

			position = root and root.Position
		end

		if not position or not target:IsDescendantOf(game) then
			data.Frame.Visible = false
			continue
		end

		local screenPosition, onScreen =
			camera:WorldToViewportPoint(position)

		data.Frame.Visible = onScreen and screenPosition.Z > 0

		if data.Frame.Visible then
			data.Frame.Position = UDim2.fromOffset(
				screenPosition.X,
				screenPosition.Y
			)
		end
	end
end)

function AuraESP.Destroy()
	AuraESP.Clear()

	if Connection then
		Connection:Disconnect()
		Connection = nil
	end

	GUI:Destroy()
end

return AuraESP
